# Server Port
SERVER_PORT=8080

# Database Engine Selection ('sqlite' or 'mysql')
DB_TYPE=sqlite
DB_SQLITE_URL=jdbc:sqlite:data/ai_researchhub.db

# MySQL Settings (if using local MySQL Server)
DB_MYSQL_URL=jdbc:mysql://localhost:3306/ai_researchhub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=your_mysql_password_here

# JWT Authentication Secret Key
JWT_SECRET=ai_researchhub_super_secret_jwt_key_2026_xyz

# Upload Directory for Datasets
UPLOAD_DIR=uploads

# Free AI API Configuration ('free' for Pollinations zero-key, 'gemini', 'groq', 'openai', 'offline')
AI_PROVIDER=free
AI_MODEL=openai
AI_API_KEY=
